<!DOCTYPE html>
<html>
<head>
    <title>Update Student</title>
</head>

<body>

    <h2>Update Student</h2>

    <form method="post" action="/ui/student/<%= student._id %>">

        <input
            type="text"
            name="email"
            value="<%= student.email %>"
        >

        <input
            type="text"
            name="testValue"
            value="<%= student.testValue %>"
        >

        <button type="submit">
            Update Student
        </button>

    </form>

</body>
</html>