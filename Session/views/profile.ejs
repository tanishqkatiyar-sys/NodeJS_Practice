<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .profile-card {
            background: white;
            width: 380px;
            padding: 35px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        }

        .profile-image {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #007bff;
            margin-bottom: 15px;
        }

        h1 {
            color: #333;
            margin-bottom: 8px;
        }

        .email {
            color: #666;
            margin-bottom: 25px;
        }

        .profile-info {
            text-align: left;
            margin-bottom: 25px;
            line-height: 2;
            color: #444;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 12px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 15px;
            border: none;
            cursor: pointer;
        }

        .edit-btn {
            background: #007bff;
            color: white;
        }

        .logout-btn {
            background: #dc3545;
            color: white;
        }

        .btn:hover {
            opacity: 0.85;
        }
    </style>
</head>

<body>

    <div class="profile-card">

        <h1>Welcome <%=data.userName%></h1>

    </div>

</body>
</html>