<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>students</title>
</head>
<body>
    <table border="1">
        <tr>
            <td>Email</td>
            <td>Password</td>
        </tr>
        <%students.forEach(student=>{%>
            <tr>
                <td><%=student.email%></td>
                <td><%=student.testValue%></td>
                <td><a href="/delete/<%=student._id%>">Delete</a></td>
                <td><a href="/ui/student/<%=student._id%>">Update</a></td>
            </tr>
        <%})%>
    </table>
</body>
</html>